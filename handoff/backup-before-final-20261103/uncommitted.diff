+  </div>
+
+
+  <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-7">
+    <h2 class="text-lg font-black text-slate-900 mb-4">選擇付款方式</h2>
+    <div class="grid grid-cols-3 gap-3">
+      <form method="post">{% csrf_token %}<input type="hidden" name="action" value="select"><input type="hidden" name="method" value="credit_card">
+        <button type="submit" class="w-full py-5 px-2 rounded-2xl border font-bold text-sm transition {% if method == 'credit_card' %}border-jp-primary bg-brand-50 text-jp-primaryHover{% else %}border-slate-200 bg-white text-slate-600 hover:border-brand-300{% endif %}"><span class="block text-3xl mb-2">💳</span>信用卡</button>
+      </form>
+      <form method="post">{% csrf_token %}<input type="hidden" name="action" value="select"><input type="hidden" name="method" value="atm">
+        <button type="submit" class="w-full py-5 px-2 rounded-2xl border font-bold text-sm transition {% if method == 'atm' %}border-jp-primary bg-brand-50 text-jp-primaryHover{% else %}border-slate-200 bg-white text-slate-600 hover:border-brand-300{% endif %}"><span class="block text-3xl mb-2">🏧</span>ATM 轉帳</button>
+      </form>
+      <form method="post">{% csrf_token %}<input type="hidden" name="action" value="select"><input type="hidden" name="method" value="cvs">
+        <button type="submit" class="w-full py-5 px-2 rounded-2xl border font-bold text-sm transition {% if method == 'cvs' %}border-jp-primary bg-brand-50 text-jp-primaryHover{% else %}border-slate-200 bg-white text-slate-600 hover:border-brand-300{% endif %}"><span class="block text-3xl mb-2">🏪</span>超商代碼</button>
+      </form>
+    </div>
+
+    {% if error %}<div class="bg-red-50 text-red-600 font-bold px-4 py-3 rounded-lg mt-4">{{ error }}</div>{% endif %}
+
+    {% if method == 'credit_card' %}
+    <div class="bg-slate-50 rounded-2xl p-5 mt-5">
+      <form method="post" class="ef-form">
+        {% csrf_token %}
+        <input type="hidden" name="action" value="pay_card"><input type="hidden" name="method" value="credit_card">
+        <label>持卡人姓名</label>
+        <input type="text" name="card_name" placeholder="WANG XIAO MING" required autocomplete="cc-name">
+        <label>卡號</label>
+        <input type="text" name="card_number" inputmode="numeric" placeholder="4242 4242 4242 4242" required autocomplete="cc-number">
+        <div class="flex gap-3">
+          <div class="flex-1"><label>有效期限</label><input type="text" name="card_expiry" placeholder="MM/YY" required autocomplete="cc-exp"></div>
+          <div class="flex-1"><label>安全碼 CVC</label><input type="text" name="card_cvc" inputmode="numeric" placeholder="123" required autocomplete="cc-csc"></div>
