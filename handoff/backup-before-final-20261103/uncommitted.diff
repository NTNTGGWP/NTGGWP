+      <a href="{% url 'take_quiz' chapter.id %}" class="inline-block bg-jp-primary hover:bg-jp-primaryHover text-white font-bold px-8 py-3 rounded-lg transition">回去重新測驗 →</a>
+    </div>
+  </div>
+  {% endif %}
+
+  <div class="space-y-4">
+    {% for a in answers %}
+    <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6">
+      <div class="flex items-start gap-2 mb-3">
+        <span class="shrink-0 mt-0.5 {% if a.is_correct %}text-green-600{% else %}text-red-500{% endif %}">
+          <i class="fas {% if a.is_correct %}fa-circle-check{% else %}fa-circle-xmark{% endif %}"></i>
+        </span>
+        <p class="font-bold text-slate-800">{{ a.question.question_text }}</p>
+      </div>
+      <div class="space-y-1.5 ml-6">
+        {% for opt in a.question.options %}
+        <div class="flex items-center gap-2 text-sm
+          {% if forloop.counter0 == a.question.correct_index %}text-green-700 font-medium
+          {% elif forloop.counter0 == a.selected_index %}text-red-600
+          {% else %}text-slate-500{% endif %}">
+          {% if forloop.counter0 == a.question.correct_index %}<i class="fas fa-check text-xs"></i>
+          {% elif forloop.counter0 == a.selected_index %}<i class="fas fa-xmark text-xs"></i>
+          {% else %}<span class="w-3"></span>{% endif %}
+          <span>{{ opt }}</span>
+          {% if forloop.counter0 == a.selected_index and not a.is_correct %}<span class="text-xs text-red-400">（你的答案）</span>{% endif %}
+        </div>
+        {% endfor %}
+      </div>
+      {% if a.question.explanation %}
+      <div class="mt-3 ml-6 text-sm text-slate-600 bg-slate-50 rounded-lg px-3 py-2"><b>解析：</b>{{ a.question.explanation }}</div>
+      {% endif %}
+    </div>
+    {% endfor %}
+  </div>
+
+  <div class="flex gap-3 mt-6">
+    <a href="{% url 'take_quiz' chapter.id %}" class="flex-1 text-center bg-jp-primary hover:bg-jp-primaryHover text-white font-bold py-3 rounded-lg transition">再測一次</a>
+    <a href="{% url 'watch_course' course.id %}" class="flex-1 text-center bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-3 rounded-lg transition">返回課程</a>
+  </div>
+</main>
+
+<style>
+  .prose-diagnosis ul { list-style: disc; padding-left: 1.25rem; margin: .4rem 0; }
+  .prose-diagnosis ol { list-style: decimal; padding-left: 1.4rem; margin: .4rem 0; }
+  .prose-diagnosis li { margin: .2rem 0; }
+  .prose-diagnosis strong { color: #0f172a; font-weight: 700; }
+  .prose-diagnosis p { margin: .4rem 0; }
+</style>
+<script>
+(function () {
+  const box = document.querySelector('[data-diagnosis-box]');
+  if (!box) return;
+  const btn = box.querySelector('[data-diagnosis-btn]');
+  const resultWrap = box.querySelector('[data-diagnosis-result]');
+  const textEl = box.querySelector('[data-diagnosis-text]');
+  const topicsEl = box.querySelector('[data-diagnosis-topics]');
+  const url = "{% url 'learning_diagnosis' course.id %}";
+  const csrftoken = "{{ csrf_token }}";
+
+  function esc(s) {
+    const d = document.createElement('div');
+    d.textContent = s;
+    return d.innerHTML;
+  }
+
+  // 極輕量 Markdown：先跳脫 HTML，再處理 **粗體** 與 - / 數字清單
+  function renderMarkdown(md) {
+    const lines = esc(md).split('\n');
+    let html = '', listType = null;
+    const closeList = () => { if (listType) { html += `</${listType}>`; listType = null; } };
+    for (let raw of lines) {
+      let line = raw.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
+      const ulm = line.match(/^\s*[-・]\s+(.*)$/);
+      const olm = line.match(/^\s*\d+\.\s+(.*)$/);
+      if (ulm) {
+        if (listType !== 'ul') { closeList(); html += '<ul>'; listType = 'ul'; }
+        html += `<li>${ulm[1]}</li>`;
+      } else if (olm) {
+        if (listType !== 'ol') { closeList(); html += '<ol>'; listType = 'ol'; }
+        html += `<li>${olm[1]}</li>`;
+      } else if (line.trim() === '') {
+        closeList();
+      } else {
+        closeList();
+        html += `<p>${line}</p>`;
+      }
+    }
+    closeList();
+    return html;
+  }
+
+  btn.addEventListener('click', async () => {
+    btn.disabled = true;
+    btn.textContent = 'AI 分析中…';
+    try {
+      const res = await fetch(url, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrftoken },
+        body: JSON.stringify({}),
+      });
+      const data = await res.json();
+      if (data.ok) {
+        textEl.innerHTML = renderMarkdown(data.diagnosis);
+        topicsEl.innerHTML = '';
+        (data.weak_topics || []).forEach(t => {
+          const chip = document.createElement('span');
+          chip.className = 'text-xs bg-amber-100 text-amber-700 font-bold px-3 py-1 rounded-full';
+          chip.textContent = '需加強：' + t;
+          topicsEl.appendChild(chip);
+        });
+        resultWrap.classList.remove('hidden');
+        btn.textContent = '重新分析';
+      } else {
+        textEl.innerHTML = '<p class="text-amber-600">' + esc(data.error || '分析失敗，請稍後再試。') + '</p>';
+        resultWrap.classList.remove('hidden');
+        btn.textContent = '再試一次';
+      }
+    } catch (e) {
+      textEl.innerHTML = '<p class="text-red-500">連線失敗，請稍後再試。</p>';
+      resultWrap.classList.remove('hidden');
+      btn.textContent = '再試一次';
+    } finally {
+      btn.disabled = false;
+    }
+  });
+})();
+
+// AI 補救練習
+(function () {
+  const box = document.querySelector('[data-remedial-box]');
+  if (!box) return;
+  const btn = box.querySelector('[data-remedial-btn]');
+  const listEl = box.querySelector('[data-remedial-list]');
+  const footer = box.querySelector('[data-remedial-footer]');
+  const url = "{% url 'remedial_quiz' chapter.id %}";
+  const csrftoken = "{{ csrf_token }}";
+
+  function esc(s) {
+    const d = document.createElement('div');
+    d.textContent = s;
+    return d.innerHTML;
+  }
+
+  function renderQuestions(questions) {
+    listEl.innerHTML = '';
+    questions.forEach((q, qi) => {
+      const card = document.createElement('div');
+      card.className = 'border border-slate-200 rounded-xl p-5';
+      let opts = '';
+      q.options.forEach((opt, oi) => {
+        opts += `
+          <label class="flex items-center gap-3 border border-slate-200 rounded-lg px-4 py-2.5 cursor-pointer hover:border-brand-300 transition" data-opt="${oi}">
+            <input type="radio" name="rq_${qi}" value="${oi}" class="accent-jp-primary">
+            <span class="text-slate-700">${esc(opt)}</span>
+          </label>`;
+      });
+      card.innerHTML = `
+        <p class="font-bold text-slate-800 mb-3"><span class="text-jp-accent">練習 ${qi + 1}.</span> ${esc(q.question_text)}</p>
+        <div class="space-y-2" data-opts>${opts}</div>
+        <button type="button" class="mt-3 text-sm text-jp-primary hover:underline font-medium" data-check>看答案</button>
+        <div class="hidden mt-3 text-sm bg-slate-50 rounded-lg px-3 py-2" data-feedback></div>`;
+
+      const checkBtn = card.querySelector('[data-check]');
+      const feedback = card.querySelector('[data-feedback]');
+      checkBtn.addEventListener('click', () => {
+        const chosen = card.querySelector(`input[name="rq_${qi}"]:checked`);
+        const picked = chosen ? parseInt(chosen.value) : -1;
+        card.querySelectorAll('[data-opt]').forEach((lab, oi) => {
+          if (oi === q.correct_index) lab.classList.add('border-green-400', 'bg-green-50');
+          else if (oi === picked) lab.classList.add('border-red-300', 'bg-red-50');
+        });
+        const ok = picked === q.correct_index;
+        feedback.innerHTML =
+          (ok ? '<b class="text-green-600">答對了！</b> ' : '<b class="text-red-500">再想想～</b> ')
+          + (q.explanation ? esc(q.explanation) : '');
+        feedback.classList.remove('hidden');
+      });
+      listEl.appendChild(card);
+    });
+    listEl.classList.remove('hidden');
+    footer.classList.remove('hidden');
+  }
+
+  btn.addEventListener('click', async () => {
+    btn.disabled = true;
+    btn.textContent = 'AI 出題中…';
+    try {
+      const res = await fetch(url, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrftoken },
+        body: JSON.stringify({}),
+      });
+      const data = await res.json();
+      if (data.ok) {
+        renderQuestions(data.questions);
+        btn.textContent = '重新出題';
+      } else {
+        listEl.innerHTML = '<p class="text-amber-600 text-sm">' + esc(data.error || '出題失敗，請稍後再試。') + '</p>';
+        listEl.classList.remove('hidden');
+        btn.textContent = '再試一次';
+      }
+    } catch (e) {
+      listEl.innerHTML = '<p class="text-red-500 text-sm">連線失敗，請稍後再試。</p>';
+      listEl.classList.remove('hidden');
+      btn.textContent = '再試一次';
+    } finally {
+      btn.disabled = false;
+    }
+  });
+})();
+</script>
+{% endblock %}
