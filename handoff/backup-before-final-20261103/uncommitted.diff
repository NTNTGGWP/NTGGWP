+<script>
+(function () {
+    const root = document.querySelector('[data-hero-carousel]');
+    if (!root) return;
+    const slides = Array.prototype.slice.call(root.querySelectorAll('[data-slide]'));
+    const dots = Array.prototype.slice.call(root.querySelectorAll('[data-hero-dot]'));
+    if (slides.length === 0) return;
+    let idx = 0, timer;
+    function show(n) {
+        idx = (n + slides.length) % slides.length;
+        slides.forEach(function (s, i) {
+            const on = i === idx;
+            s.classList.toggle('opacity-0', !on);
+            s.classList.toggle('pointer-events-none', !on);
+        });
+        dots.forEach(function (d, i) {
+            const on = i === idx;
+            d.classList.toggle('w-6', on); d.classList.toggle('bg-white', on);
+            d.classList.toggle('w-2', !on); d.classList.toggle('bg-white/40', !on);
+        });
+    }
+    function restart() { clearInterval(timer); if (slides.length > 1) timer = setInterval(function () { show(idx + 1); }, 5000); }
+    const next = root.querySelector('[data-hero-next]');
+    const prev = root.querySelector('[data-hero-prev]');
+    if (next) next.addEventListener('click', function (e) { e.preventDefault(); show(idx + 1); restart(); });
+    if (prev) prev.addEventListener('click', function (e) { e.preventDefault(); show(idx - 1); restart(); });
+    dots.forEach(function (d, i) { d.addEventListener('click', function () { show(i); restart(); }); });
+    restart();
+})();
+</script>
