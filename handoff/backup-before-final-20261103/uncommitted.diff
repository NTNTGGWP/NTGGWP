+<script>
+document.querySelectorAll('[data-tabs] [data-tab]').forEach((btn) => {
+    btn.addEventListener('click', () => {
+        const name = btn.dataset.tab;
+        document.querySelectorAll('[data-tabs] [data-tab]').forEach((b) => {
+            const on = b === btn;
+            b.classList.toggle('border-jp-primary', on);
+            b.classList.toggle('text-jp-primary', on);
+            b.classList.toggle('font-medium', on);
+            b.classList.toggle('border-transparent', !on);
+            b.classList.toggle('text-jp-muted', !on);
+        });
+        document.querySelectorAll('[data-panel]').forEach((p) => {
+            p.classList.toggle('hidden', p.dataset.panel !== name);
+        });
+    });
+});
+
+document.querySelectorAll('[data-accordion]').forEach((accordion) => {
+    const items = accordion.querySelectorAll('[data-accordion-item]');
+    items.forEach((item, idx) => {
+        const header = item.querySelector('[data-accordion-header]');
+        const body = item.querySelector('[data-accordion-body]');
+        const icon = item.querySelector('[data-accordion-icon]');
+        const setOpen = (open) => {
+            body.classList.toggle('hidden', !open);
+            icon.classList.toggle('rotate-90', open);
+        };
+        setOpen(idx === 0);
+        header.addEventListener('click', () => {
+            setOpen(body.classList.contains('hidden'));
+        });
+    });
+});
+
+document.querySelectorAll('[data-funding-countdown]').forEach((root) => {
+    const end = new Date(root.dataset.end);
+    if (isNaN(end)) return;
+    const cells = {
+        d: root.querySelector('[data-cd="d"]'),
+        h: root.querySelector('[data-cd="h"]'),
+        m: root.querySelector('[data-cd="m"]'),
+        s: root.querySelector('[data-cd="s"]'),
+    };
+    const endedEl = root.querySelector('[data-cd-ended]');
+    function set(cell, val) {
+        if (!cell) return;
+        const str = String(val).padStart(2, '0');
+        if (cell.textContent === str) return;
+        cell.textContent = str;
+        cell.classList.remove('cd-pop');
+        void cell.offsetWidth;   // 重觸發動畫
+        cell.classList.add('cd-pop');
+    }
+    function tick() {
+        let diff = Math.floor((end - new Date()) / 1000);
+        if (diff <= 0) {
+            root.querySelectorAll('.cd-num').forEach((c) => (c.textContent = '00'));
+            if (endedEl) endedEl.classList.remove('hidden');
+            clearInterval(timer);
+            return;
+        }
+        const d = Math.floor(diff / 86400); diff -= d * 86400;
+        const h = Math.floor(diff / 3600); diff -= h * 3600;
+        const m = Math.floor(diff / 60); const s = diff - m * 60;
+        set(cells.d, d); set(cells.h, h); set(cells.m, m); set(cells.s, s);
+    }
+    tick();
+    const timer = setInterval(tick, 1000);
+});
