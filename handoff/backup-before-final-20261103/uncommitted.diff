+    <div class="bg-jp-primary text-white px-4 py-3 flex items-center justify-between">
+      <div class="font-bold"><i class="fas fa-robot mr-2"></i>AI 平台助手</div>
+      <button data-platform-ai-close class="text-white/80 hover:text-white"><i class="fas fa-times"></i></button>
+    </div>
+    <div data-platform-ai-faq class="flex flex-wrap gap-1.5 px-3 pt-3 pb-2 border-b border-slate-100 bg-white">
+      {% for faq in platform_faqs %}
+      <button type="button" data-faq-id="{{ faq.id }}" class="text-xs bg-slate-100 hover:bg-jp-primary hover:text-white text-slate-600 rounded-full px-3 py-1.5 transition whitespace-nowrap">{{ faq.label }}</button>
+      {% endfor %}
+    </div>
+    <div data-platform-ai-log class="flex-1 overflow-y-auto p-4 space-y-3 text-sm bg-slate-50">
+      <div class="bg-white rounded-xl p-3 ring-1 ring-slate-100 text-slate-600">嗨！我是 EduFlow 平台助手，想找課程、或想了解定價／折扣／退款等平台使用問題都可以問我。</div>
+    </div>
+    <form data-platform-ai-form class="p-3 border-t border-slate-100 flex gap-2">
+      <input data-platform-ai-input type="text" placeholder="輸入你的問題…" class="flex-1 border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-800 placeholder-slate-400 bg-white focus:outline-none focus:ring-2 focus:ring-brand-200" autocomplete="off">
+      <button type="submit" data-platform-ai-submit class="bg-jp-primary hover:bg-jp-primaryHover text-white font-bold px-4 rounded-lg text-sm disabled:opacity-60 disabled:cursor-not-allowed">送出</button>
+    </form>
