+{% extends 'main/base_eduflow.html' %}
+{% block title %}我的課程 | EduFlow{% endblock %}
+
+{% block content %}
+<main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
+  <div class="bg-jp-surface rounded-xl border border-jp-border shadow-sm p-7 mb-6">
+    <h1 class="text-2xl font-bold tracking-wide text-jp-text mb-1">我的課程</h1>
+    <p class="text-jp-muted mb-5">歡迎，{{ request.user.username }}。這裡顯示你已購買的課程與學習進度。</p>
+    <div class="flex gap-4 flex-wrap">
+      <div class="flex-1 min-w-[150px] bg-brand-50 rounded-xl p-4 text-center">
+        <div class="text-2xl font-bold text-jp-primary">{{ enrollments|length }}</div><div class="text-sm text-jp-muted">已購課程</div>
+      </div>
+      <div class="flex-1 min-w-[150px] bg-brand-50 rounded-xl p-4 text-center">
+        <div class="text-2xl font-bold text-jp-primary">{{ total_minutes }}</div><div class="text-sm text-jp-muted">累積學習分鐘</div>
+      </div>
+    </div>
+  </div>
+
+  {% if enrollments %}
+
+  <div class="flex gap-2 mb-6" data-filter-tabs>
+    <button type="button" data-filter="all" class="px-5 py-2 rounded-full text-sm font-bold bg-jp-primary text-white transition">全部 ({{ enrollments|length }})</button>
+    <button type="button" data-filter="in-progress" class="px-5 py-2 rounded-full text-sm font-bold bg-jp-surface text-jp-muted border border-jp-border hover:border-jp-primary transition">進行中</button>
+    <button type="button" data-filter="completed" class="px-5 py-2 rounded-full text-sm font-bold bg-jp-surface text-jp-muted border border-jp-border hover:border-jp-primary transition">已完成</button>
+  </div>
+
+  <div data-course-list class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
+    {% for enrollment in enrollments %}
+    <div class="bg-jp-surface rounded-xl border border-jp-border shadow-sm overflow-hidden flex flex-col" data-progress="{{ enrollment.progress }}">
+      <div class="aspect-video bg-jp-bg relative">
+        {% if enrollment.course.image %}<img src="{{ enrollment.course.image.url }}" alt="{{ enrollment.course.title }}" class="w-full h-full object-cover">
+        {% else %}<div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-brand-600 to-brand-400 text-white text-4xl font-bold">{{ enrollment.course.title|slice:":1"|upper }}</div>{% endif %}
+        {% if enrollment.progress == 100 %}
+        <span class="absolute top-3 right-3 bg-green-500 text-white text-xs font-bold px-2.5 py-1 rounded-full"><i class="fas fa-check mr-1"></i>已完成</span>
+        {% elif enrollment.progress > 0 %}
+        <span class="absolute top-3 right-3 bg-jp-primary text-white text-xs font-bold px-2.5 py-1 rounded-full">{{ enrollment.progress }}%</span>
+        {% endif %}
+      </div>
+      <div class="p-5 flex flex-col flex-1">
+        <h3 class="font-medium text-jp-text mb-0.5 line-clamp-2">{{ enrollment.course.title }}</h3>
+        <p class="text-sm text-jp-muted mb-3">講師：{{ enrollment.course.teacher.profile.display_name }}</p>
+
+        <div class="flex justify-between text-xs text-jp-muted mb-1.5">
+          <span>學習進度</span>
+          <span>{{ enrollment.progress }}%（{{ enrollment.completed_lessons }}/{{ enrollment.total_lessons }} 單元）</span>
+        </div>
+        <div class="h-2 bg-jp-bg rounded-full overflow-hidden mb-4"><div class="h-full bg-jp-primary rounded-full" style="width: {{ enrollment.progress }}%;"></div></div>
+
+        <div class="flex gap-2 mt-auto">
+          <a href="{% url 'course_detail' enrollment.course.id %}" class="flex-1 text-center bg-jp-bg hover:bg-jp-border text-jp-text font-medium py-2.5 rounded-lg text-sm transition">課程頁</a>
+          <a href="{% url 'watch_course' enrollment.course.id %}" class="flex-1 text-center bg-jp-primary hover:bg-jp-primaryHover text-white font-medium py-2.5 rounded-lg text-sm transition">▶ 上課</a>
+        </div>
+
+        {% if enrollment.progress == 100 %}
+        <a href="{% url 'certificate' enrollment.course.id %}" class="mt-2 text-center bg-jp-accent hover:bg-accent-600 text-white font-medium py-2.5 rounded-lg text-sm transition">🎓 下載結業證書</a>
+        {% endif %}
+
+        {% if enrollment.refund %}
+        <div class="mt-2 text-center py-2 rounded-lg text-sm font-bold
+          {% if enrollment.refund.status == 'pending' %}bg-amber-50 text-amber-700
+          {% elif enrollment.refund.status == 'rejected' %}bg-red-50 text-red-600
+          {% else %}bg-green-50 text-green-700{% endif %}">退款：{{ enrollment.refund.get_status_display }}</div>
+        {% elif enrollment.order %}
+        <a href="{% url 'request_refund' enrollment.order.id %}" class="mt-2 text-center bg-red-50 hover:bg-red-100 text-red-600 font-medium py-2.5 rounded-lg text-sm transition">申請退款</a>
+        {% endif %}
+      </div>
+    </div>
+    {% endfor %}
+  </div>
+  {% else %}
+  <div class="bg-jp-surface rounded-xl border-2 border-dashed border-jp-border shadow-sm p-16 text-center">
+    <div class="text-6xl mb-4">📚</div>
+    <h3 class="text-xl font-bold text-jp-text mb-2">還沒有購買任何課程</h3>
+    <p class="text-jp-muted mb-6">探索感興趣的課程，開始你的學習旅程吧！</p>
+    <a href="{% url 'course_catalog' %}" class="inline-block bg-jp-primary hover:bg-jp-primaryHover text-white font-bold px-8 py-3 rounded-lg transition">瀏覽課程</a>
+  </div>
+  {% endif %}
+</main>
+{% endblock %}
+
+{% block extra_js %}
+<script>
+(function () {
+  var tabs = document.querySelectorAll('[data-filter-tabs] button');
+  var cards = document.querySelectorAll('[data-course-list] [data-progress]');
+  if (!tabs.length) return;
+
+  tabs.forEach(function (tab) {
+    tab.addEventListener('click', function () {
+      var filter = tab.dataset.filter;
+      tabs.forEach(function (t) {
+        var on = t === tab;
+        t.className = 'px-5 py-2 rounded-full text-sm font-bold transition ' +
+          (on ? 'bg-jp-primary text-white' : 'bg-jp-surface text-jp-muted border border-jp-border hover:border-jp-primary');
+      });
+      cards.forEach(function (card) {
+        var p = parseInt(card.dataset.progress);
+        var show = filter === 'all' ||
+                   (filter === 'completed' && p === 100) ||
+                   (filter === 'in-progress' && p < 100);
+        card.style.display = show ? '' : 'none';
+      });
+    });
+  });
+})();
+</script>
+{% endblock %}
