+<script>
+(function () {
+    var grid = document.querySelector('[data-course-grid]');
+    var btns = document.querySelectorAll('[data-view-toggle] button');
+    if (!grid || !btns.length) return;
+    btns.forEach(function (btn) {
+        btn.addEventListener('click', function () {
+            var mode = btn.dataset.view;
+            btns.forEach(function (b) {
+                var on = b === btn;
+                b.className = 'px-3 py-2 text-sm ' + (on ? 'bg-jp-primary text-white' : 'bg-jp-surface text-jp-muted hover:text-jp-primary');
+            });
+            if (mode === 'list') {
+                grid.className = 'space-y-3';
+                grid.querySelectorAll('article').forEach(function (card) {
+                    card.className = (card.className || '').replace(/rounded-lg/g, 'rounded-xl') + ' flex flex-row h-32';
+                    var img = card.querySelector('.aspect-video');
+                    if (img) { img.className = img.className.replace('aspect-video', '') + ' w-48 h-full shrink-0'; }
+                });
+            } else {
+                grid.className = 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6';
+                grid.querySelectorAll('article').forEach(function (card) {
+                    card.className = card.className.replace(/ flex flex-row h-32/g, '').replace(/rounded-xl/g, 'rounded-lg');
+                    var img = card.querySelector('.w-48');
+                    if (img) { img.className = img.className.replace('w-48 h-full shrink-0', '') + ' aspect-video'; }
+                });
+            }
+        });
+    });
+})();
+</script>
+{% endblock %}
