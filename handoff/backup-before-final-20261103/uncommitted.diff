+    let html = '', listType = null;
+    const closeList = () => { if (listType) { html += `</${listType}>`; listType = null; } };
+    for (let raw of lines) {
+      let line = raw.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
+      const ulm = line.match(/^\s*[-・]\s+(.*)$/);
+      const olm = line.match(/^\s*\d+\.\s+(.*)$/);
+      if (ulm) { if (listType !== 'ul') { closeList(); html += '<ul>'; listType = 'ul'; } html += `<li>${ulm[1]}</li>`; }
+      else if (olm) { if (listType !== 'ol') { closeList(); html += '<ol>'; listType = 'ol'; } html += `<li>${olm[1]}</li>`; }
+      else if (line.trim() === '') { closeList(); }
+      else { closeList(); html += `<p>${line}</p>`; }
+    }
+    closeList();
+    return html;
+  }
+
+  btn.addEventListener('click', async () => {
+    btn.disabled = true;
+    btn.textContent = 'AI 分析中…';
+    try {
+      const res = await fetch(url, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrftoken },
+        body: JSON.stringify({}),
+      });
+      const data = await res.json();
+      resultEl.innerHTML = data.ok
+        ? renderMarkdown(data.analysis)
+        : '<p class="text-amber-600">' + esc(data.error || '分析失敗，請稍後再試。') + '</p>';
+      resultEl.classList.remove('hidden');
+      btn.textContent = data.ok ? '重新分析' : '再試一次';
+    } catch (e) {
+      resultEl.innerHTML = '<p class="text-red-500">連線失敗，請稍後再試。</p>';
+      resultEl.classList.remove('hidden');
+      btn.textContent = '再試一次';
+    } finally {
+      btn.disabled = false;
+    }
+  });
+})();
+</script>
+{% endblock %}
