+      </a>
+      <a href="{% url 'my_revenue' %}" class="text-brand-600 hover:underline font-medium">查看收支明細 →</a>
+    </div>
+  </div>
+
+
+  {% if has_bank_account %}
+  <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-5 mb-6 flex items-center justify-between gap-4 flex-wrap">
+    <div class="text-sm text-slate-600"><i class="fas fa-building-columns text-brand-600 mr-2"></i>收款帳戶：{{ bank_account.bank_name }} ・ 戶名 {{ bank_account.account_name }} ・ 帳號 {{ bank_account.account_number }}</div>
