+
+          <div class="mt-4 flex items-center gap-3">
+            {% if prev_lesson_id %}
+            <a href="{% url 'watch_lesson' prev_lesson_id %}" class="flex-1 flex items-center justify-center gap-2 border border-slate-200 hover:border-brand-300 text-slate-600 hover:text-jp-primary rounded-lg py-2.5 font-medium text-sm transition"><i class="fas fa-chevron-left"></i> 上一堂</a>
+            {% else %}
+            <span class="flex-1 flex items-center justify-center gap-2 border border-slate-100 text-slate-300 rounded-lg py-2.5 font-medium text-sm cursor-not-allowed"><i class="fas fa-chevron-left"></i> 上一堂</span>
+            {% endif %}
+            {% if next_lesson_id %}
+            <a href="{% url 'watch_lesson' next_lesson_id %}" class="flex-1 flex items-center justify-center gap-2 bg-jp-primary hover:bg-jp-primaryHover text-white rounded-lg py-2.5 font-bold text-sm transition">下一堂 <i class="fas fa-chevron-right"></i></a>
+            {% else %}
+            <a href="{% url 'course_detail' course.id %}" class="flex-1 flex items-center justify-center gap-2 bg-jp-accent hover:bg-accent-600 text-white rounded-lg py-2.5 font-bold text-sm transition">🎉 回到課程頁</a>
+            {% endif %}
+          </div>
+
+          <input type="hidden" id="csrftoken" value="{{ csrf_token }}" />
+          {% endif %}
+        </div>
+      </div>
+    </div>
+
+
+    <aside>
+      <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-5 lg:sticky lg:top-24 max-h-[calc(100vh-120px)] overflow-y-auto no-scrollbar">
+        <h2 class="text-lg font-black text-slate-900 mb-2">課程內容</h2>
+        <div class="flex justify-between text-sm text-slate-500 mb-1.5"><span>完成進度</span><span>{{ done_count }}/{{ total_lessons }}（{{ progress }}%）</span></div>
+        <div class="h-2 bg-slate-100 rounded-full overflow-hidden mb-4"><div class="h-full bg-gradient-to-r from-brand-600 to-violet-500 rounded-full" style="width: {{ progress }}%;"></div></div>
+
+        {% if progress == 100 %}
+        <a href="{% url 'certificate' course.id %}" class="block text-center bg-jp-accent hover:bg-accent-600 text-white font-bold py-2.5 rounded-lg mb-4 transition">🎓 下載結業證書</a>
+        {% endif %}
+
+        {% for chapter in chapters %}
+        <div class="text-xs font-black text-slate-400 mt-4 mb-1.5">第 {{ chapter.sort_order }} 章：{{ chapter.title }}</div>
+        {% for l in chapter.lessons.all %}
+          {% if can_record or l.is_free_preview %}
+          <a href="{% url 'watch_lesson' l.id %}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm mb-1 transition {% if l.id == lesson.id %}bg-brand-50 text-jp-primaryHover font-bold{% else %}text-slate-700 hover:bg-slate-50{% endif %}">
+            <span class="w-5 h-5 rounded-full flex items-center justify-center text-[11px] shrink-0 {% if l.id in completed_ids %}bg-green-500 text-white{% else %}border border-slate-300 text-transparent{% endif %}"><i class="fas fa-check"></i></span>
+            <span class="flex-1">{{ chapter.sort_order }}-{{ l.sort_order }} {{ l.title }}</span>
