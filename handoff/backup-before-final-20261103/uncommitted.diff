+        user.save()
+    else:
+        user.email = email
+        if is_superuser:
+            user.is_staff = True
+            user.is_superuser = True
+        user.save()
+
+    if role:
+        Profile.objects.get_or_create(
+            user=user,
+            defaults={"role": role}
+        )
+
+    return user
