+    last_attempt = QuizAttempt.objects.filter(user=request.user, quiz=quiz).first()
+    return render(request, 'main/take_quiz.html', {
+        'course': course,
+        'chapter': chapter,
+        'quiz': quiz,
+        'questions': questions,
+        'last_attempt': last_attempt,
