+{% block extra_js %}
+<script>
+  (function () {
+    var video = document.querySelector(".video-box video");
+    if (!video) return;
+
+    var RESUME = {{ resume_position|default:0 }};
+    var SAVE_URL = "{% url 'save_progress' lesson.id %}";
+    var tokenEl = document.getElementById("csrftoken");
+    var canRecord = !!tokenEl;
+    var csrf = tokenEl ? tokenEl.value : "";
+    var pctEl = document.getElementById("watchPct");
+    var doneTag = document.getElementById("doneTag");
+    var progText = document.getElementById("progText");
+
+    function seekResume() {
+      if (RESUME > 0 && isFinite(video.duration) && RESUME < video.duration) {
+        try { video.currentTime = RESUME; } catch (e) {}
+      }
+    }
+    video.addEventListener("loadedmetadata", seekResume);
+    if (video.readyState >= 1) seekResume();
+
+    if (!canRecord) return;
+
+    var watched = new Set();
+    var pending = [];
+    var lastPos = 0;
+    var completed = false;
+
+    video.addEventListener("timeupdate", function () {
+      if (!video.paused && !video.seeking) {
+        var s = Math.floor(video.currentTime);
+        if (!watched.has(s)) { watched.add(s); pending.push(s); }
+      }
+      lastPos = Math.floor(video.currentTime);
+    });
+
+    function buildForm() {
+      var fd = new FormData();
+      fd.append("csrfmiddlewaretoken", csrf);
+      fd.append("seconds", pending.join(","));
+      fd.append("position", lastPos);
+      fd.append("duration", Math.floor(video.duration) || 0);
+      pending = [];
+      return fd;
+    }
+
+    function save() {
+      if (completed && pending.length === 0) return;
+      if (pending.length === 0 && lastPos === 0) return;
+      fetch(SAVE_URL, { method: "POST", body: buildForm() })
+        .then(function (r) { return r.json(); })
+        .then(function (d) {
+          if (!d || !d.ok) return;
+          if (pctEl) pctEl.textContent = d.progress + "%";
+          if (d.completed && !completed) {
+            completed = true;
+            if (progText) progText.style.display = "none";
+            if (doneTag) doneTag.style.display = "";
+          }
+        })
+        .catch(function () {});
+    }
+
+    setInterval(save, 10000);
+    video.addEventListener("pause", save);
+    video.addEventListener("ended", save);
+
+    function flush() {
+      if (pending.length === 0) return;
+      try { navigator.sendBeacon(SAVE_URL, buildForm()); } catch (e) { save(); }
+    }
+    document.addEventListener("visibilitychange", function () {
+      if (document.visibilityState === "hidden") flush();
+    });
+    window.addEventListener("pagehide", flush);
+
+    var speedCtrl = document.getElementById("speedControls");
+    if (speedCtrl) speedCtrl.style.display = "";
+    var speedBtns = document.querySelectorAll(".speed-btn");
+    speedBtns.forEach(function (btn) {
+      btn.addEventListener("click", function () {
+        var rate = parseFloat(btn.dataset.speed);
+        if (!isNaN(rate)) video.playbackRate = rate;
+        speedBtns.forEach(function (b) {
+          var isActive = b === btn;
+          b.className = "speed-btn text-xs px-2.5 py-1 rounded-lg transition " +
+            (isActive ? "border-2 border-jp-primary text-jp-primary font-bold" : "border border-slate-200 text-slate-500 hover:border-brand-300 hover:text-jp-primary");
+        });
+      });
+    });
+
+    document.addEventListener("keydown", function (e) {
+      if (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA" || e.target.isContentEditable) return;
+      switch (e.key) {
+        case " ":
+        case "k":
+          e.preventDefault();
+          video.paused ? video.play() : video.pause();
+          break;
+        case "ArrowLeft":
+        case "j":
+          e.preventDefault();
+          video.currentTime = Math.max(0, video.currentTime - 5);
+          break;
+        case "ArrowRight":
+        case "l":
+          e.preventDefault();
+          video.currentTime = Math.min(video.duration || Infinity, video.currentTime + 5);
+          break;
+        case "ArrowUp":
+          e.preventDefault();
+          video.volume = Math.min(1, video.volume + 0.1);
+          break;
+        case "ArrowDown":
+          e.preventDefault();
+          video.volume = Math.max(0, video.volume - 0.1);
+          break;
+        case "m":
+          video.muted = !video.muted;
+          break;
+        case "f":
+          if (document.fullscreenElement) document.exitFullscreen();
+          else video.requestFullscreen && video.requestFullscreen();
+          break;
+      }
+    });
+
+    {% if next_lesson_id %}
+    var nextUrl = "{% url 'watch_lesson' next_lesson_id %}";
+    var autoTimer = null;
+    var overlay = null;
+    video.addEventListener("ended", function () {
+      if (overlay) return;
+      overlay = document.createElement("div");
+      overlay.className = "absolute inset-0 bg-black/80 flex flex-col items-center justify-center gap-4 z-10";
+      overlay.innerHTML = '<p class="text-white text-lg font-bold">即將播放下一堂</p>' +
+        '<div class="text-white/70 text-sm">自動跳轉 <span id="cd-sec" class="text-electric font-bold">5</span> 秒</div>' +
+        '<div class="flex gap-3">' +
+        '<button id="cd-cancel" class="px-5 py-2 rounded-lg border border-white/30 text-white text-sm hover:bg-white/10 transition">取消</button>' +
+        '<a href="' + nextUrl + '" class="px-5 py-2 rounded-lg bg-jp-primary hover:bg-jp-primaryHover text-white text-sm font-bold transition">立即播放</a>' +
+        '</div>';
+      var box = document.querySelector(".video-box");
+      box.style.position = "relative";
+      box.appendChild(overlay);
+      var sec = 5;
+      var cdEl = overlay.querySelector("#cd-sec");
+      autoTimer = setInterval(function () {
+        sec--;
+        if (cdEl) cdEl.textContent = sec;
+        if (sec <= 0) { clearInterval(autoTimer); window.location.href = nextUrl; }
+      }, 1000);
+      overlay.querySelector("#cd-cancel").addEventListener("click", function () {
+        clearInterval(autoTimer);
+        overlay.remove();
+        overlay = null;
+      });
+    });
+    {% endif %}
+  })();
+</script>
+{% endblock %}
