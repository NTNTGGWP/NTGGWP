+        log.scrollTop = log.scrollHeight;
+    }
+
+    function setBusy(isBusy, label) {
+        busy = isBusy;
+        input.disabled = isBusy;
+        submitBtn.disabled = isBusy;
+        submitBtn.textContent = label || (isBusy ? '思考中...' : SUBMIT_LABEL);
+    }
+
+    function startCooldown() {
+        submitBtn.textContent = SUBMIT_LABEL;
+        submitBtn.disabled = true;
+        setTimeout(() => {
+            busy = false;
+            input.disabled = false;
+            submitBtn.disabled = false;
+            input.focus();
+        }, COOLDOWN_MS);
+    }
+
+    async function sendQuestion(q) {
+        if (busy || !q) return;
+        setBusy(true);
+        bubble(q, 'user');
+        chatHistory.push({ role: 'user', text: q });
+        input.value = '';
+        const thinking = bubble('思考中...', 'ai');
+        try {
+            const res = await fetch(askUrl, {
+                method: 'POST',
+                headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrftoken },
+                body: JSON.stringify({ question: q, history: chatHistory.slice(0, -1) }),
+            });
+            const data = await res.json();
+            const answer = data.ok ? data.answer : (data.error || '發生錯誤，請稍後再試。');
+            thinking.textContent = answer;
+            chatHistory.push({ role: 'ai', text: answer });
+            if (data.suggestions) renderSuggestions(data.suggestions);
+        } catch (err) {
+            thinking.textContent = '連線失敗，請稍後再試。';
+        } finally {
+            startCooldown();
+        }
+    }
+
+    form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        sendQuestion(input.value.trim());
+    });
+
+    var copyBtn = document.querySelector('[data-copy-url]');
