+{{ platform_faqs|json_script:"platform-faqs-data" }}
+<script>
+(function () {
+    var counters = document.querySelectorAll('[data-counter]');
+    if (!counters.length) return;
+    var animated = new Set();
+    function animateCounter(el) {
+        var target = parseInt(el.dataset.counter, 10);
+        if (isNaN(target) || target <= 0) { el.textContent = target; return; }
+        var duration = 1200;
+        var start = performance.now();
+        function tick(now) {
+            var t = Math.min((now - start) / duration, 1);
+            var ease = 1 - Math.pow(1 - t, 3); // easeOutCubic
+            el.textContent = Math.round(ease * target).toLocaleString();
+            if (t < 1) requestAnimationFrame(tick);
+        }
+        requestAnimationFrame(tick);
+    }
+    var observer = new IntersectionObserver(function (entries) {
+        entries.forEach(function (entry) {
+            if (entry.isIntersecting && !animated.has(entry.target)) {
+                animated.add(entry.target);
+                animateCounter(entry.target);
+            }
+        });
+    }, { threshold: 0.3 });
+    counters.forEach(function (el) { observer.observe(el); });
+})();
+</script>
+<script>
+(function () {
+    const root = document.querySelector('[data-platform-ai-assistant]');
+    if (!root) return;
+    const panel = root.querySelector('[data-platform-ai-panel]');
+    const log = root.querySelector('[data-platform-ai-log]');
+    const form = root.querySelector('[data-platform-ai-form]');
+    const input = root.querySelector('[data-platform-ai-input]');
+    const submitBtn = root.querySelector('[data-platform-ai-submit]');
+    const SUBMIT_LABEL = submitBtn.textContent;
+    const COOLDOWN_MS = 1000;
+    let busy = false;
+    const csrftoken = '{{ csrf_token }}';
+    const askUrl = "{% url 'ask_platform_ai' %}";
+    const faqDataEl = document.getElementById('platform-faqs-data');
+    const FAQS = faqDataEl ? JSON.parse(faqDataEl.textContent) : [];
+
+    const chatHistory = [];
+
+    root.querySelector('[data-platform-ai-toggle]').addEventListener('click', () => {
+        panel.classList.toggle('hidden');
+        if (!panel.classList.contains('hidden')) input.focus();
+        const ping = root.querySelector('[data-platform-ai-ping]');
+        if (ping) ping.remove();
+    });
+    root.querySelector('[data-platform-ai-close]').addEventListener('click', () => panel.classList.add('hidden'));
+
+    root.querySelectorAll('[data-platform-ai-faq] [data-faq-id]').forEach((btn) => {
+        btn.addEventListener('click', () => {
+            const faq = FAQS.find((f) => f.id === btn.dataset.faqId);
+            if (!faq) return;
+            bubble(faq.question, 'user');
+            setTimeout(() => bubble(faq.answer, 'ai'), 300);
+        });
+    });
+
+    function bubble(text, who) {
+        const el = document.createElement('div');
+        el.className = who === 'user'
+            ? 'bg-jp-primary text-white rounded-xl p-3 ml-8'
+            : 'bg-white rounded-xl p-3 ring-1 ring-slate-100 text-slate-700 whitespace-pre-line';
+        el.textContent = text;
+        log.appendChild(el);
+        log.scrollTop = log.scrollHeight;
+        return el;
+    }
+
+    function renderSuggestions(suggestions) {
+        if (!suggestions || suggestions.length === 0) return;
+        const wrap = document.createElement('div');
+        wrap.className = 'flex flex-wrap gap-1.5 mt-1';
+        suggestions.forEach((s) => {
+            const btn = document.createElement('button');
+            btn.type = 'button';
+            btn.className = 'text-xs bg-slate-100 hover:bg-jp-primary hover:text-white text-slate-600 rounded-full px-3 py-1.5 transition text-left';
+            btn.textContent = s;
+            btn.addEventListener('click', () => {
+                wrap.remove();
+                sendQuestion(s);
+            });
+            wrap.appendChild(btn);
+        });
+        log.appendChild(wrap);
+        log.scrollTop = log.scrollHeight;
+    }
+
+    function setBusy(isBusy, label) {
+        busy = isBusy;
+        input.disabled = isBusy;
+        submitBtn.disabled = isBusy;
+        submitBtn.textContent = label || (isBusy ? '思考中...' : SUBMIT_LABEL);
+    }
+
+    function startCooldown() {
+        submitBtn.textContent = SUBMIT_LABEL;
+        submitBtn.disabled = true;
+        setTimeout(() => {
+            busy = false;
+            input.disabled = false;
+            submitBtn.disabled = false;
+            input.focus();
+        }, COOLDOWN_MS);
+    }
+
+    async function sendQuestion(q) {
+        if (busy || !q) return;
+        setBusy(true);
+        bubble(q, 'user');
+        chatHistory.push({ role: 'user', text: q });
+        input.value = '';
+        const thinking = bubble('思考中...', 'ai');
+        try {
+            const res = await fetch(askUrl, {
+                method: 'POST',
+                headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrftoken },
+                body: JSON.stringify({ question: q, history: chatHistory.slice(0, -1) }),
+            });
+            const data = await res.json();
+            const answer = data.ok ? data.answer : (data.error || '發生錯誤，請稍後再試。');
+            thinking.textContent = answer;
+            chatHistory.push({ role: 'ai', text: answer });
+            if (data.suggestions) renderSuggestions(data.suggestions);
+        } catch (err) {
+            thinking.textContent = '連線失敗，請稍後再試。';
+        } finally {
+            startCooldown();
+        }
+    }
+
+    form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        sendQuestion(input.value.trim());
+    });
+})();
+</script>
+{% endif %}
+{% endblock %}
