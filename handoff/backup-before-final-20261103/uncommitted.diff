+      {% endif %}
+
+      {% if item.admin_note %}
+      <div class="bg-slate-50 rounded-lg p-3 mt-4 text-sm text-slate-600">後台備註：{{ item.admin_note }}</div>
+      {% endif %}
+
+      {% if item.status == 'approved' and item.is_fulfilled %}
+      <div class="grid sm:grid-cols-3 gap-3 mt-4">
+        <div class="bg-slate-50 rounded-lg p-3">
