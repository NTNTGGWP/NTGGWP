+{% extends 'main/base_eduflow.html' %}
+{% block title %}老師課程分析 | EduFlow{% endblock %}
+{% block extra_head %}<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>{% endblock %}
+
+{% block content %}
+<main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
+  <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-7 mb-6">
+    <div class="flex items-center justify-between gap-3 flex-wrap mb-1">
+      <h1 class="text-2xl font-black text-slate-900">老師課程分析</h1>
+      <div id="filterStatus" class="hidden items-center gap-2">
+        <span class="bg-brand-50 text-jp-primaryHover font-bold px-3 py-1.5 rounded-full text-sm">篩選中：<span id="filterCourseName"></span></span>
+        <button id="clearFilterBtn" type="button" class="text-slate-400 hover:text-slate-600 text-sm font-medium">清除篩選 ✕</button>
+      </div>
+    </div>
+    <p class="text-slate-500 mb-5">依課程訂單、觀看紀錄與評價即時產生分析圖表。點擊任一圖表的長條，可篩選並連動其他圖表與數據。</p>
+    <div class="grid sm:grid-cols-3 gap-4">
+      <div class="bg-slate-50 rounded-xl p-5"><h3 class="text-sm text-slate-500 mb-1">總營收</h3><div id="totalRevenueValue" class="text-3xl font-black text-jp-primaryHover">NT$ {{ total_revenue }}</div></div>
+      <div class="bg-slate-50 rounded-xl p-5"><h3 class="text-sm text-slate-500 mb-1">總購買數</h3><div id="totalPurchaseValue" class="text-3xl font-black text-jp-primaryHover">{{ total_purchase_count }}</div></div>
+      <div class="bg-slate-50 rounded-xl p-5"><h3 class="text-sm text-slate-500 mb-1">總觀看分鐘</h3><div id="totalWatchValue" class="text-3xl font-black text-jp-primaryHover">{{ total_watch_minutes }}</div></div>
+    </div>
+  </div>
+
+  <div class="grid md:grid-cols-2 gap-6 mb-6">
+    <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6"><h2 class="font-black text-slate-900 mb-4">各課程購買數</h2><div class="relative h-72"><canvas id="purchaseChart"></canvas></div></div>
+    <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6"><h2 class="font-black text-slate-900 mb-4">各課程營收</h2><div class="relative h-72"><canvas id="revenueChart"></canvas></div></div>
+    <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6"><h2 class="font-black text-slate-900 mb-4">各課程觀看分鐘</h2><div class="relative h-72"><canvas id="watchChart"></canvas></div></div>
+    <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6"><h2 class="font-black text-slate-900 mb-4">各課程平均評分</h2><div class="relative h-72"><canvas id="ratingChart"></canvas></div></div>
+  </div>
+
+  <a href="{% url 'teacher_dashboard' %}" class="inline-block text-jp-primary hover:underline font-medium">← 回教師專區</a>
+</main>
+{% endblock %}
+
+{% block extra_js %}
+{{ course_labels_json|json_script:"ta-labels" }}
+{{ purchase_counts_json|json_script:"ta-purchases" }}
+{{ revenue_data_json|json_script:"ta-revenue" }}
+{{ watch_minutes_data_json|json_script:"ta-watch" }}
+{{ rating_data_json|json_script:"ta-rating" }}
+<script>
+  const courseLabels = JSON.parse(document.getElementById("ta-labels").textContent);
+  const purchaseCounts = JSON.parse(document.getElementById("ta-purchases").textContent);
+  const revenueData = JSON.parse(document.getElementById("ta-revenue").textContent);
+  const watchMinutesData = JSON.parse(document.getElementById("ta-watch").textContent);
+  const ratingData = JSON.parse(document.getElementById("ta-rating").textContent);
+  const totalRevenue = {{ total_revenue }};
+  const totalPurchaseCount = {{ total_purchase_count }};
+  const totalWatchMinutes = {{ total_watch_minutes }};
+
+  const COLORS = { purchase: "#4f46e5", revenue: "#7c3aed", watch: "#ec4899", rating: "#f59e0b" };
+  const FADE_COLOR = "rgba(148, 163, 184, 0.35)"; // 未選取時淡化為 slate-400
+
+  let selectedIndex = null;
+  const charts = {};
+
+  function colorsFor(baseColor) {
+    return courseLabels.map((_, i) => (selectedIndex === null || selectedIndex === i) ? baseColor : FADE_COLOR);
+  }
+
+  function refreshChartColors() {
+    Object.entries(charts).forEach(([key, chart]) => {
+      chart.data.datasets[0].backgroundColor = colorsFor(COLORS[key]);
+      chart.update();
+    });
+  }
+
+  function refreshSummaryTiles() {
+    const statusEl = document.getElementById("filterStatus");
+    if (selectedIndex === null) {
+      document.getElementById("totalRevenueValue").textContent = "NT$ " + totalRevenue.toLocaleString();
+      document.getElementById("totalPurchaseValue").textContent = totalPurchaseCount.toLocaleString();
+      document.getElementById("totalWatchValue").textContent = totalWatchMinutes.toLocaleString();
+      statusEl.classList.add("hidden");
+      statusEl.classList.remove("flex");
+    } else {
+      document.getElementById("totalRevenueValue").textContent = "NT$ " + revenueData[selectedIndex].toLocaleString();
+      document.getElementById("totalPurchaseValue").textContent = purchaseCounts[selectedIndex].toLocaleString();
+      document.getElementById("totalWatchValue").textContent = watchMinutesData[selectedIndex].toLocaleString();
+      document.getElementById("filterCourseName").textContent = courseLabels[selectedIndex];
+      statusEl.classList.remove("hidden");
+      statusEl.classList.add("flex");
+    }
+  }
+
+  function setSelection(index) {
+    selectedIndex = (selectedIndex === index) ? null : index;
+    refreshChartColors();
+    refreshSummaryTiles();
+  }
+
+  function bar(id, key, label, data, extra) {
+    const chart = new Chart(document.getElementById(id), {
+      type: "bar",
+      data: { labels: courseLabels, datasets: [{ label: label, data: data, backgroundColor: colorsFor(COLORS[key]), borderRadius: 6 }] },
+      options: Object.assign({
+        responsive: true,
+        maintainAspectRatio: false,
+        onClick: (evt, elements) => {
+          if (elements.length) setSelection(elements[0].index);
+        },
+        onHover: (evt, elements) => {
+          evt.native.target.style.cursor = elements.length ? "pointer" : "default";
+        },
+      }, extra || {}),
+    });
+    charts[key] = chart;
+  }
+
+  bar("purchaseChart", "purchase", "購買數", purchaseCounts);
+  bar("revenueChart", "revenue", "營收", revenueData);
+  bar("watchChart", "watch", "觀看分鐘", watchMinutesData);
+  bar("ratingChart", "rating", "平均評分", ratingData, { scales: { y: { min: 0, max: 5 } } });
+
+  document.getElementById("clearFilterBtn").addEventListener("click", () => setSelection(null));
+</script>
+{% endblock %}
