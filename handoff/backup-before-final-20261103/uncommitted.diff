+def _active_provider():
+    forced = (getattr(settings, 'AI_PROVIDER', '') or '').strip().lower()
+    if forced in ('azure', 'gemini', 'anthropic'):
+        return forced
+    if _azure_configured():
+        return 'azure'
+    if getattr(settings, 'GEMINI_API_KEY', ''):
+        return 'gemini'
+    if getattr(settings, 'ANTHROPIC_API_KEY', ''):
+        return 'anthropic'
+    return None
