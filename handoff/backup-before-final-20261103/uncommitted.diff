+  }
+
+  var WEEKS = Math.ceil(days.length / 7);
+  var LABEL_W = 24;
+  var svgW = LABEL_W + WEEKS * STEP;
+  var svgH = ROWS * STEP + 20; // extra for month labels
+
+  function color(mins) {
+    if (!mins || mins <= 0) return '#1b2130';
+    if (mins < 10) return '#065f46';
+    if (mins < 30) return '#059669';
+    if (mins < 60) return '#34d399';
+    return '#6ee7b7';
+  }
+
+  var svg = '<svg width="' + svgW + '" height="' + svgH + '" xmlns="http://www.w3.org/2000/svg">';
+
+  for (var r = 0; r < ROWS; r++) {
+    if (DAY_LABELS[r]) {
+      svg += '<text x="0" y="' + (20 + r * STEP + CELL - 2) + '" fill="#aab2c7" font-size="10" font-family="sans-serif">' + DAY_LABELS[r] + '</text>';
+    }
+  }
+
+  var lastMonth = -1;
+  var MONTHS = ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月'];
+
+  for (var i = 0; i < days.length; i++) {
+    var date = days[i];
+    var col = Math.floor(i / 7);
+    var row = i % 7;
+    var key = date.toISOString().slice(0, 10);
+    var mins = data[key] || 0;
+    var x = LABEL_W + col * STEP;
+    var y = 20 + row * STEP;
+
+    if (row === 0 && date.getMonth() !== lastMonth && date.getDate() <= 7) {
+      lastMonth = date.getMonth();
+      svg += '<text x="' + x + '" y="12" fill="#aab2c7" font-size="10" font-family="sans-serif">' + MONTHS[date.getMonth()] + '</text>';
+    }
+
+    var title = key + '：' + mins + ' 分鐘';
+    svg += '<rect x="' + x + '" y="' + y + '" width="' + CELL + '" height="' + CELL + '" rx="2" fill="' + color(mins) + '">' +
+      '<title>' + title + '</title></rect>';
+  }
+
+  svg += '</svg>';
+  container.innerHTML = svg;
+})();
+</script>
+{% endblock %}
