+      </form>
+    </div>
+
+    {% elif method == 'atm' %}
+    <div class="bg-slate-50 rounded-2xl p-5 mt-5">
+      <div class="flex justify-between py-2.5 border-b border-dashed border-slate-200"><span>銀行代碼</span><b>013（模擬）</b></div>
+      <div class="flex justify-between py-2.5 border-b border-dashed border-slate-200"><span>虛擬帳號</span><span class="text-xl font-black text-jp-primaryHover tracking-widest">{{ payment.virtual_account }}</span></div>
+      <div class="flex justify-between py-2.5 border-b border-dashed border-slate-200"><span>應付金額</span><b>NT$ {{ order.final_price }}</b></div>
+      <div class="flex justify-between py-2.5"><span>繳費期限</span><b>{{ payment.expire_at|date:"Y-m-d H:i" }}</b></div>
+      <p class="text-slate-400 text-sm mt-2">請於期限內以網銀／ATM 轉帳至上方虛擬帳號。完成後按下方按鈕（模擬銀行入帳回拋）。</p>
+      <form method="post" class="mt-4">{% csrf_token %}<input type="hidden" name="action" value="confirm_offline"><input type="hidden" name="method" value="atm">
+        <button type="submit" class="w-full bg-jp-primary hover:bg-jp-primaryHover text-white font-bold py-3 rounded-lg transition">我已完成轉帳（模擬入帳）</button>
+      </form>
+    </div>
+
+    {% elif method == 'cvs' %}
+    <div class="bg-slate-50 rounded-2xl p-5 mt-5">
+      <div class="flex justify-between py-2.5 border-b border-dashed border-slate-200"><span>超商繳費代碼</span><span class="text-xl font-black text-jp-primaryHover tracking-widest">{{ payment.payment_code }}</span></div>
+      <div class="flex justify-between py-2.5 border-b border-dashed border-slate-200"><span>應付金額</span><b>NT$ {{ order.final_price }}</b></div>
+      <div class="flex justify-between py-2.5"><span>繳費期限</span><b>{{ payment.expire_at|date:"Y-m-d H:i" }}</b></div>
+      <p class="text-slate-400 text-sm mt-2">請持繳費代碼至四大超商多媒體機台列印繳費單付款。完成後按下方按鈕（模擬超商回拋）。</p>
+      <form method="post" class="mt-4">{% csrf_token %}<input type="hidden" name="action" value="confirm_offline"><input type="hidden" name="method" value="cvs">
+        <button type="submit" class="w-full bg-jp-primary hover:bg-jp-primaryHover text-white font-bold py-3 rounded-lg transition">我已完成繳費（模擬）</button>
+      </form>
+    </div>
+    {% else %}
+    <p class="text-slate-400 text-sm mt-4">請選擇上方任一付款方式繼續。付款完成後才會開通課程。</p>
+    {% endif %}
+  </div>
+
+  <a href="{% url 'home' %}" class="inline-block mt-5 text-jp-primary hover:underline font-medium">← 稍後再付款（訂單保留於待付款）</a>
+</main>
+{% endblock %}
