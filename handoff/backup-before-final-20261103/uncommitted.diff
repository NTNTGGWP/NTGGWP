+def _profile_to_text(profile):
+    """把結構化 profile 轉成餵給模型的可讀文字。"""
+    lines = [
+        f"課程：{profile['course_title']}",
+        f"整體完成率：{profile['overall_completion_pct']}%"
+        f"（{profile['completed_lessons']}/{profile['total_lessons']} 個單元）",
+        '',
+        '各章節學習狀況：',
