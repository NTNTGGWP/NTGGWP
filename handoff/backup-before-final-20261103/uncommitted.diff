+              <span id="progText" style="{% if is_completed %}display:none;{% endif %}">本單元觀看進度：<b id="watchPct" class="text-jp-primary">{{ lesson_percent }}%</b><span class="text-slate-400 font-normal text-sm ml-1">（累積計算，看滿 60% 即完成，快轉不計）</span></span>
+            </div>
+            <a href="{% url 'course_detail' course.id %}" class="ml-auto text-jp-primary hover:underline font-medium text-sm">回課程頁</a>
+          </div>
